# Salin file ini menjadi .env lalu isi nilainya. File .env tidak ikut ke Git.

# Alamat backend.
#
# Biarkan KOSONG saat pengembangan — request dibiarkan relatif dan diteruskan
# proxy Vite ke http://localhost:8080, sehingga frontend & backend tampak satu
# origin dan cookie autentikasi httpOnly ikut terkirim.
#
# Di produksi (Vercel) proxy Vite tidak ikut ter-build, jadi alamat backend
# harus disebut penuh. Tanpa trailing slash.
# Contoh: https://glowmarket-api.onrender.com
VITE_API_URL=

# OAuth Client ID Google (APIs & Services > Credentials di Google Cloud Console).
# Harus sama persis dengan google.oauth.client-id di backend, karena backend
# memakainya untuk memverifikasi audience token. Kosong = tombol login Google
# otomatis disembunyikan.
VITE_GOOGLE_CLIENT_ID=
